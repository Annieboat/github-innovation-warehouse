# A fine-grained token with read-only access to public repositories raises rate limits.
GITHUB_TOKEN=
GHIW_DATABASE=data/github_warehouse.duckdb
GHIW_RAW_DIR=data/raw
GHIW_USER_AGENT=github-innovation-warehouse/0.1
GHIW_REQUEST_TIMEOUT=30

# Optional: required only for the all-organization BigQuery workflow.
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GHIW_ORG_JSON_DIR=exports/organizations
GHIW_TARGET_DATASET=github_data
GHIW_TARGET_JSON_OUTPUT=exports/target-organizations
